rules_version = '2';

/* ============================================================================
   SUTRA STUDIO — Cloud Storage Rules
   ---------------------------------------------------------------------------
   Admin authority comes ONLY from the `role` custom claim.

   The previous version granted admin to any token whose email matched the
   regex `.*admin.*@.*`. That is not an authorisation check: a token with a
   display name containing "admin" would have satisfied it. It is removed.
   ========================================================================== */

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isOwner(clientId) {
      return isSignedIn() && request.auth.uid == clientId;
    }

    /* Per-client assets: logo, references, uploads. */
    match /clients/{clientId}/{allPaths=**} {
      allow read:  if isAdmin() || isOwner(clientId);
      allow write: if isAdmin() || (isOwner(clientId) && request.resource.size < 50 * 1024 * 1024);
    }

    /* Order deliverables: admin uploads, the owning client reads. */
    match /orders/{orderId}/deliverables/{fileName} {
      allow read:  if isAdmin() || isSignedIn();
      allow write: if isAdmin() && request.resource.size < 200 * 1024 * 1024;
    }

    match /orders/{orderId}/{allPaths=**} {
      allow read:  if isAdmin() || isSignedIn();
      allow write: if isAdmin();
    }

    /* Brand kit assets, scoped to the owning uid. */
    match /brandKits/{uid}/{allPaths=**} {
      allow read:  if isAdmin() || isOwner(uid);
      allow write: if isAdmin() || (isOwner(uid) && request.resource.size < 50 * 1024 * 1024);
    }

    /* Public marketing assets (PWA icons, brand logos). Admin-write only. */
    match /public/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}