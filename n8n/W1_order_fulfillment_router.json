        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"kling-v1\",\n  \"prompt\": \"{{ $('Fetch Order Context from Sutra App').item.json.requirements }}. Cinematic luxury architectural cinematography, 4k resolution, smooth camera dolly.\",\n  \"negative_prompt\": \"blurry, low quality, glitch, distortion\",\n  \"cfg_scale\": 0.5,\n  \"mode\": \"std\",\n  \"aspect_ratio\": \"16:9\",\n  \"duration\": \"5\"\n}"
      },
