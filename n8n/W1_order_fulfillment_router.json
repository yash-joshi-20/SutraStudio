        "jsonBody": "={\n  \"text\": \"{{ $('Fetch Order Context from Sutra App').item.json.requirements || 'Experience premium Indian craftsmanship infused with modern spatial intelligence by Sutra Studio.' }}\",\n  \"model_id\": \"eleven_multilingual_v2\",\n  \"voice_settings\": {\n    \"stability\": 0.65,\n    \"similarity_boost\": 0.85\n  }\n}"
      },
