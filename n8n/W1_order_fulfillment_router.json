      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"received\": true,\n  \"orderId\": \"{{ $json.body?.orderId || $json.orderId }}\",\n  \"status\": \"queued\",\n  \"message\": \"Order intake verified by Sutra Studio Fulfillment Router.\"\n}",
