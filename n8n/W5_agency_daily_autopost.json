{
  "name": "Sutra Studio — W5 Agency Daily Autoposter",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "node-w5-schedule",
      "name": "Daily Scheduled Post (10:00 AM IST)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"You are Chief Creative Officer at Sutra Studio (luxury Indian design studio combining spatial architecture, CGI, and digital intelligence). Generate today's flagship Instagram post: 1. Headline Hook, 2. Editorial Narrative Caption, 3. 5 Target Hashtags (#SutraStudio #SpatialDesign #IndianModernism #3DVisualization #LuxuryInteriors), 4. Visual Prompt for 1:1 architectural showcase.\"\n    }]\n  }]\n}"
      },
      "id": "node-w5-ai-caption",
      "name": "Draft Sutra Studio Brand Editorial",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.stability.ai/v1/generation/stable-diffusion-xl-1024-v1-0/text-to-image",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer ={{ $env.STABILITY_API_KEY || $env.IMAGE_PROVIDER_API_KEY }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text_prompts\": [\n    {\n      \"text\": \"Luxury architectural courtyard with teak timber wood lattices, soft diffused sunlight, travertine stone, brass accents, warm minimalism, 8k render, architectural digest aesthetic.\",\n      \"weight\": 1\n    }\n  ],\n  \"cfg_scale\": 7.5,\n  \"height\": 1024,\n  \"width\": 1024,\n  \"samples\": 1,\n  \"steps\": 30\n}"
      },
      "id": "node-w5-render-image",
      "name": "Render Studio Showcase Artwork",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_BASE_URL || 'http://localhost:3000' }}/api/n8n/webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-sutra-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET || 'sutra_n8n_sec_live_9941a8' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"runId\": \"sutra_autopost_draft_{{ $now.timestamp }}\",\n  \"workflowId\": \"W5_agency_daily_autopost\",\n  \"status\": \"draft_ready\",\n  \"deliverableUrl\": \"https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80\",\n  \"filename\": \"Sutra_Daily_Showcase_{{ $now.format('yyyy_MM_dd') }}.png\",\n  \"notes\": \"Agency daily social post draft created in Draft-Mode. Requires Admin approval before publishing live to Instagram.\"\n}"
      },
      "id": "node-w5-draft-admin-vault",
      "name": "Save Draft to Admin Dashboard (Draft-Mode Default)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 300]
    },
    {
      "parameters": {},
      "id": "node-w5-merge",
      "name": "Merge Autopost Pipeline",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1180, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_BASE_URL || 'http://localhost:3000' }}/api/audit-logs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-sutra-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET || 'sutra_n8n_sec_live_9941a8' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"actorUid\": \"n8n_agency_autoposter\",\n  \"actorEmail\": \"automation@sutrastudio.com\",\n  \"actorRole\": \"system\",\n  \"action\": \"DAILY_AUTOPOST_DRAFTED\",\n  \"resourceType\": \"social_post\",\n  \"resourceId\": \"draft_showcase_{{ $now.format('yyyyMMdd') }}\",\n  \"details\": {\n    \"workflow\": \"W5_agency_daily_autopost\",\n    \"draftMode\": true,\n    \"status\": \"awaiting_admin_approval\"\n  }\n}"
      },
      "id": "node-w5-single-log",
      "name": "Single Audit Log Entry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, 300]
    }
  ],
  "connections": {
    "Daily Scheduled Post (10:00 AM IST)": {
      "main": [
        [
          {
            "node": "Draft Sutra Studio Brand Editorial",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Draft Sutra Studio Brand Editorial": {
      "main": [
        [
          {
            "node": "Render Studio Showcase Artwork",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render Studio Showcase Artwork": {
      "main": [
        [
          {
            "node": "Save Draft to Admin Dashboard (Draft-Mode Default)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Draft to Admin Dashboard (Draft-Mode Default)": {
      "main": [
        [
          {
            "node": "Merge Autopost Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge Autopost Pipeline": {
      "main": [
        [
          {
            "node": "Single Audit Log Entry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "W4_error_handler"
  }
}
