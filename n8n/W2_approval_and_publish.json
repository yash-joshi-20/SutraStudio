{
  "name": "Sutra Studio — W2 Post-Approval & Publish Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "W2_approval_and_publish",
        "responseMode": "responseNode",
        "options": {
          "rawBody": false
        }
      },
      "id": "node-w2-webhook",
      "name": "Approved Creative Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "sutra-w2-publisher"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"received\": true,\n  \"orderId\": \"{{ $json.body?.orderId || $json.orderId }}\",\n  \"status\": \"publishing_queued\",\n  \"message\": \"Publishing job queued after verified client approval.\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-w2-respond-200",
      "name": "Respond 200 Immediately",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body?.publishTarget?.platform || $json.platform || 'instagram' }}",
        "rules": {
          "rules": [
            {
              "value2": "instagram",
              "outputKey": "instagram"
            },
            {
              "value2": "facebook",
              "outputKey": "facebook"
            },
            {
              "value2": "both",
              "outputKey": "both"
            }
          ]
        },
        "fallbackOutput": 0
      },
      "id": "node-w2-channel-switch",
      "name": "Route by Social Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $('Approved Creative Intake Webhook').item.json.body?.publishTarget?.igUserId || $env.INSTAGRAM_ACCOUNT_ID }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{ $('Approved Creative Intake Webhook').item.json.body?.publishTarget?.mediaUrl || $('Approved Creative Intake Webhook').item.json.mediaUrl }}"
            },
            {
              "name": "caption",
              "value": "={{ $('Approved Creative Intake Webhook').item.json.body?.publishTarget?.caption || 'Crafted with Sutra Studio creative intelligence.' }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.META_ACCESS_TOKEN }}"
            }
          ]
        }
      },
      "id": "node-ig-create-container",
      "name": "Create Instagram Media Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 160]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "node-wait-ig-transcode",
      "name": "Wait for Media Transcode",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1180, 160],
      "webhookId": "sutra-wait-ig"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v19.0/{{ $('Create Instagram Media Container').item.json.id }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "status_code,status"
            },
            {
              "name": "access_token",
              "value": "={{ $env.META_ACCESS_TOKEN }}"
            }
          ]
        }
      },
      "id": "node-poll-ig-status",
      "name": "Poll Container Status (FINISHED)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $('Approved Creative Intake Webhook').item.json.body?.publishTarget?.igUserId || $env.INSTAGRAM_ACCOUNT_ID }}/media_publish",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{ $('Create Instagram Media Container').item.json.id }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.META_ACCESS_TOKEN }}"
            }
          ]
        }
      },
      "id": "node-ig-publish-media",
      "name": "Publish to Instagram Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $('Approved Creative Intake Webhook').item.json.body?.publishTarget?.facebookPageId || $env.FACEBOOK_PAGE_ID }}/photos",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $('Approved Creative Intake Webhook').item.json.body?.publishTarget?.mediaUrl || $('Approved Creative Intake Webhook').item.json.mediaUrl }}"
            },
            {
              "name": "message",
              "value": "={{ $('Approved Creative Intake Webhook').item.json.body?.publishTarget?.caption || 'New design release from Sutra Studio.' }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.META_ACCESS_TOKEN }}"
            }
          ]
        }
      },
      "id": "node-facebook-publish-photo",
      "name": "Publish to Facebook Page Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 440]
    },
    {
      "parameters": {},
      "id": "node-w2-merge-publishing",
      "name": "Merge Published Responses",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1940, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_BASE_URL || 'http://localhost:3000' }}/api/n8n/webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-sutra-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET || 'sutra_n8n_sec_live_9941a8' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"orderId\": \"{{ $('Approved Creative Intake Webhook').item.json.body?.orderId || $('Approved Creative Intake Webhook').item.json.orderId }}\",\n  \"clientId\": \"{{ $('Approved Creative Intake Webhook').item.json.body?.clientId }}\",\n  \"runId\": \"sutra_pub_{{ $now.timestamp }}\",\n  \"workflowId\": \"W2_approval_and_publish\",\n  \"status\": \"published\",\n  \"notes\": \"Live published to connected Meta / Instagram channels successfully.\"\n}"
      },
      "id": "node-w2-report-published",
      "name": "Log Publish Success to Sutra Ledger",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2180, 300]
    }
  ],
  "connections": {
    "Approved Creative Intake Webhook": {
      "main": [
        [
          {
            "node": "Respond 200 Immediately",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Respond 200 Immediately": {
      "main": [
        [
          {
            "node": "Route by Social Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by Social Channel": {
      "main": [
        [
          {
            "node": "Create Instagram Media Container",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Publish to Facebook Page Feed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Create Instagram Media Container",
            "type": "main",
            "index": 0
          },
          {
            "node": "Publish to Facebook Page Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Instagram Media Container": {
      "main": [
        [
          {
            "node": "Wait for Media Transcode",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Media Transcode": {
      "main": [
        [
          {
            "node": "Poll Container Status (FINISHED)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Container Status (FINISHED)": {
      "main": [
        [
          {
            "node": "Publish to Instagram Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish to Instagram Feed": {
      "main": [
        [
          {
            "node": "Merge Published Responses",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish to Facebook Page Feed": {
      "main": [
        [
          {
            "node": "Merge Published Responses",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge Published Responses": {
      "main": [
        [
          {
            "node": "Log Publish Success to Sutra Ledger",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "W4_error_handler"
  }
}
