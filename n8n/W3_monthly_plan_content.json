{
  "name": "Sutra Studio — W3 Monthly Plan Content Generator",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "node-w3-schedule-trigger",
      "name": "Daily Scheduled Trigger (09:00 AM IST)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.APP_BASE_URL || 'http://localhost:3000' }}/api/n8n/subscriptions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-sutra-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET || 'sutra_n8n_sec_live_9941a8' }}"
            }
          ]
        }
      },
      "id": "node-fetch-active-subscriptions",
      "name": "Fetch Active Monthly Subscriptions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "subscriptions",
        "options": {}
      },
      "id": "node-item-lists-split",
      "name": "Loop Over Active Retainers",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"You are Senior Creative Strategist at Sutra Studio. Generate this week's creative deliverables batch for monthly retainer client:\\nClient: {{ $json.clientName }}\\nPlan: {{ $json.planName }}\\nBrief: {{ $json.requirements }}\\nTrial Status: {{ $json.isTrial ? '3-Day Active Trial' : 'Paid Active Retainer' }}\\nOutput a structured content batch: 1. Visual Creative Concept, 2. Instagram Carousel Copy with Hooks, 3. 9:16 Video Reel Script, 4. Production Checklist for Studio Admin review.\"\n    }]\n  }]\n}"
      },
      "id": "node-generate-retainer-batch",
      "name": "Generate Retainer Content Batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_BASE_URL || 'http://localhost:3000' }}/api/n8n/webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-sutra-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET || 'sutra_n8n_sec_live_9941a8' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"orderId\": \"{{ $('Loop Over Active Retainers').item.json.orderId }}\",\n  \"clientId\": \"{{ $('Loop Over Active Retainers').item.json.clientUid }}\",\n  \"runId\": \"sutra_monthly_{{ $now.timestamp }}\",\n  \"workflowId\": \"W3_monthly_plan_content\",\n  \"status\": \"draft_ready\",\n  \"driveFolder\": \"02 Drafts\",\n  \"filename\": \"Monthly_Retainer_Batch_{{ $now.format('yyyy_MM_dd') }}.pdf\",\n  \"notes\": \"Daily recurring retainer draft cycle compiled for {{ $('Loop Over Active Retainers').item.json.clientName }}. Vaulted for Admin inspection.\"\n}"
      },
      "id": "node-report-monthly-draft-ready",
      "name": "Vault Draft & Notify Admin Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Daily Scheduled Trigger (09:00 AM IST)": {
      "main": [
        [
          {
            "node": "Fetch Active Monthly Subscriptions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Active Monthly Subscriptions": {
      "main": [
        [
          {
            "node": "Loop Over Active Retainers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Over Active Retainers": {
      "main": [
        [
          {
            "node": "Generate Retainer Content Batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Retainer Content Batch": {
      "main": [
        [
          {
            "node": "Vault Draft & Notify Admin Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "W4_error_handler"
  }
}
