  "knowledgeBase": [
    {
      "id": "kb_001",
      "title": "4K Spatial Render Deliverables & SLA",
      "category": "service_details",
      "question": "What is included in a 3D Spatial Architecture deliverable?",
      "answer": "Each 3D Spatial Architecture commission includes 4K ultra-high resolution renders (ProRes / EXR / PNG), baked GLTF/GLB models for web embedding, 2 lighting passes (Midday & Golden Hour), and 2 revision rounds with 48h turnaround.",
      "status": "active",
      "source": "admin_manual",
      "createdAt": "2026-09-15T10:00:00.000Z",
      "updatedAt": "2026-09-15T10:00:00.000Z"
    },
    {
      "id": "kb_002",
      "title": "Client Google Drive Vault Protocol",
      "category": "business_rules",
      "question": "How are final renders and assets delivered to clients?",
      "answer": "All production masters, project archives, videos, and 3D files are encrypted and automatically mirrored to the client's dedicated Google Drive Vault folder (e.g. drive_fld_sutra_001). Direct access links are accessible in Media Vault.",
      "status": "active",
      "source": "admin_manual",
      "createdAt": "2026-09-16T11:30:00.000Z",
      "updatedAt": "2026-09-16T11:30:00.000Z"
    },
    {
      "id": "kb_003",
      "title": "Payment Terms & Razorpay Workflow",
      "category": "business_rules",
      "question": "What payment options are available and when does production start?",
      "answer": "Commissions require upfront payment via Razorpay Checkout (UPI, Cards, NetBanking, Corporate). Once payment status transitions to 'paid', the order enters active production queue.",
