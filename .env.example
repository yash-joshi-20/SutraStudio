# ==============================================================================
# SUTRA STUDIO — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SECURITY NOTICE:
# - Fill with your real credentials in `.env.local` (never commit `.env.local` to git).
# - Client-side code only accesses variables prefixed with `NEXT_PUBLIC_`.
# - Server-side keys are strictly protected from frontend exposure.
# ==============================================================================

# Core Application URLs & Admin Identity
APP_BASE_URL=https://sutrastudio-1.onrender.com
NEXT_PUBLIC_APP_URL=https://sutrastudio-1.onrender.com
NEXT_PUBLIC_SITE_URL=https://sutrastudio-1.onrender.com
NEXTAUTH_URL=https://sutrastudio-1.onrender.com
ADMIN_EMAIL=yashjoshi20@zohomail.in
# Server-only, comma-separated, compared case-insensitively. Only these
# addresses may sign in to the admin portal (see Step 1 of the build prompt).
ADMIN_ALLOWED_EMAILS=yashjoshi20@zohomail.in
# Mailbox that receives admin login alerts and all client-facing notices.
ADMIN_NOTIFY_EMAIL=yashjoshi20@zohomail.in
NODE_ENV=

# Firebase Client SDK (Public) — Authentication + Firestore ONLY.
# No Storage bucket (media lives in Google Drive) and no Cloud Functions
# (schedules run through n8n / external cron), so the free Spark plan is enough.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Legacy — Firebase Storage is no longer used (all media lives in Google Drive).
# Kept as an empty name for compatibility with older tooling; nothing reads it.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Admin SDK (Server) — session cookies, custom claims, Firestore writes.
# Option A (easiest): path to the JSON downloaded from
#   Firebase console -> Project settings -> Service accounts
FIREBASE_SERVICE_ACCOUNT=
# Option B: the same two values pasted inline (keep the \n escapes in the key)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Google Drive Storage Vault (Server-Side) — ALL media lives here.
# Auth is an OAuth REFRESH TOKEN (a service account has no quota on a personal
# 5 TB Drive). Scope is the narrow https://www.googleapis.com/auth/drive.file,
# so the app can only touch files it created itself.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional. Under drive.file a folder you made by hand is invisible, so leave
# this blank and the app creates "SUTRA STUDIO VAULT" on first use and stores
# its id in Firestore (studio_config/drive). Set it only if Drive already
# reports that folder as accessible to the OAuth account.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Legacy — service-account Drive auth is NOT usable on a personal Drive (no
# storage quota) and was replaced by the OAuth refresh token above. Kept as
# empty names only; nothing reads them.
GOOGLE_DRIVE_SERVICE_ACCOUNT=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_CLIENT_EMAIL=

# Razorpay Payment Gateway & Webhooks
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Pay & Direct UPI Settlement (Zero-Commission)
NEXT_PUBLIC_DEFAULT_UPI_VPA=
NEXT_PUBLIC_DEFAULT_UPI_PAYEE=
NEXT_PUBLIC_MERCHANT_UPI_VPA=

# AI & Multimodal Creative Engines
GEMINI_API_KEY=
IMAGE_PROVIDER_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
ELEVENLABS_API_KEY=
SERPAPI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
BFL_API_KEY=
SAMBANOVA_API_KEY=
RUNWAY_API_KEY=
HEYGEN_API_KEY=

# Meta Graph, Instagram, Facebook & WhatsApp
FACEBOOK_PAGE_ID=61594200943169
META_AD_ACCOUNT_ID=act_1092549996582729
META_APP_ID=
META_APP_SECRET=
META_GRAPH_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_HANDLE=yashsutrastudio
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/yashsutrastudio/
NEXT_PUBLIC_FACEBOOK_PAGE_URL=https://www.facebook.com/yashsutrastudio/
NEXT_PUBLIC_FACEBOOK_PROFILE_URL=https://www.facebook.com/yashjoshisutrastudio/
NEXT_PUBLIC_WHATSAPP_NUMBER=918200192781

# Local n8n Automation Engine & Webhooks
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=
N8N_API_KEY=
NEXT_PUBLIC_N8N_URL=
N8N_MASTER_DISPATCH_WEBHOOK=http://localhost:5678/webhook/sutra-master-dispatch
N8N_INBOUND_WEBHOOK=http://localhost:5678/webhook/sutra-inbound-inquiry

# Zoho Inbound & Outbound Mail Engine (SMTP / IMAP)
ZOHO_MAIL_USER=yashjoshi20@zohomail.in
ZOHO_MAIL_PASSWORD=
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
IMAP_HOST=imap.zoho.in
IMAP_PORT=993
EMAIL_FROM=yashjoshi20@zohomail.in
EMAIL_REPLY_TO=yashjoshi20@zohomail.in

# Scheduled Jobs — n8n or any external cron, no Cloud Functions involved.
# GET/POST /api/cron/notifications  (trial expiry, 5-day & 1-day reminders)
# GET/POST /api/cron/retention      (draft/revision pruning after N days)
# Both accept:  Authorization: Bearer <N8N_WEBHOOK_SECRET>   (or CRON_SECRET)
CRON_SECRET=

# Optional Analytics & Telemetry
NEXT_PUBLIC_GA_MEASUREMENT_ID=
SENTRY_DSN=
