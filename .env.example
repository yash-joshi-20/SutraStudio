# ==============================================================================
# SUTRA STUDIO — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Notice: NEVER commit production secrets or service account keys.
# Frontend client code only consumes NEXT_PUBLIC_ variables.

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://sutrastudio.com

# Firebase Client Configuration (Public API Keys only)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA_example_sutra_public_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sutra-studio-production.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sutra-studio-production
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sutra-studio-production.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=109283746501
NEXT_PUBLIC_FIREBASE_APP_ID=1:109283746501:web:987a6b5c4d3e2f10

# Firebase Server / Admin SDK (Server-Side ONLY - Never expose in client code)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@sutra-studio-production.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Google Drive Storage Integration (Server-Side ONLY)
GOOGLE_DRIVE_ROOT_FOLDER_ID=1A2B3C4D5E6F7G8H9I0J_sutra_vault
GOOGLE_DRIVE_CLIENT_EMAIL=drive-sync@sutra-studio-production.iam.gserviceaccount.com
# GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# OPTIONAL PRODUCTION CAPABILITIES & SERVICES
# ==============================================================================

# RAG & LLM Embedding Pipeline (Server-Side ONLY)
OPENAI_API_KEY=sk-proj-example-sutra-openai-key
PINECONE_API_KEY=pcsk_example_sutra_pinecone_key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=sutra-knowledge-base

# INR Payment Gateway (Razorpay / Stripe)
RAZORPAY_KEY_ID=rzp_live_example_sutra_id
RAZORPAY_KEY_SECRET=rzp_secret_example_sutra_key
# STRIPE_SECRET_KEY=sk_live_example_sutra_stripe_key
# STRIPE_WEBHOOK_SECRET=whsec_example_sutra_stripe_webhook

# Notification Services (Email / SMS)
