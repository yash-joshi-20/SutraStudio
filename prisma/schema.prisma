// use prisma-8
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  uid             String   @unique
  email           String   @unique
  passwordHash    String?
  name            String
  phone           String?
  role            String   @default("client") // "client" | "admin"
  photoURL        String?
  emailVerified   Boolean  @default(false)
  company         String   @default("")
  tier            String   @default("Standard")
  status          String   @default("Active")
  billingData     String?  @db.Text
  driveFolderId   String   @default("")
  driveFolderLink String?
  adminNotes      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          Order[]
  payments        Payment[]
  notifications   Notification[]
}

model Order {
  id            String   @id
  orderNumber   String   @unique
  clientUid     String
  clientName    String
  clientEmail   String
  service       String
  packageName   String?
  packageId     String?
  totalAmount   Float
  amountPaid    Float    @default(0)
  status        String   @default("pending_verification")
  paymentStatus String   @default("pending_payment")
  turnaround    String?
  brief         String?  @db.Text
  source        String   @default("web")
  metadata      String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?    @relation(fields: [clientUid], references: [uid])
  payments      Payment[]
}

model Payment {
  id            String   @id
  orderId       String?
  clientUid     String?
  clientEmail   String?
  amount        Float
  method        String   @default("upi_qr")
  status        String   @default("pending_verification")
  utr           String?
  receiptUrl    String?
  metadata      String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?    @relation(fields: [clientUid], references: [uid])
  order         Order?   @relation(fields: [orderId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userUid   String?
  title     String
  message   String   @db.Text
  type      String   @default("system")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userUid], references: [uid])
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String?  @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model KeyValue {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
