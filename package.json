{
  "name": "sutra-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "cross-env NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run lint && node scripts/verify-env-protection.mjs && node scripts/security-acceptance-tests.mjs",
    "test:env": "node scripts/verify-env-protection.mjs",
    "test:e2e": "node scripts/step8-e2e-verification.mjs",
    "test:security": "node scripts/security-acceptance-tests.mjs",
    "test:workflows": "node scripts/ai-workflow-regression.mjs",
    "test:storage": "node scripts/storage-regression.mjs",
    "test:production": "node scripts/production-checks.mjs && node scripts/verify-env-protection.mjs",
    "test:audit": "node scripts/final-acceptance-audit.mjs",
    "audit": "node scripts/final-acceptance-audit.mjs",
    "test:admin": "node scripts/step31c-admin-security-test.mjs",
    "check:auth": "node scripts/check-auth.mjs",
    "create-admin": "npx tsx scripts/create-admin.ts",
    "get-drive-token": "npx tsx scripts/get-drive-refresh-token.ts",
    "migrate:firebase": "node scripts/migrate-to-firebase.mjs",
    "migrate:dry-run": "node scripts/migrate-to-firebase.mjs --dry-run",
    "capture-assets": "npx tsx scripts/capture-live-assets.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^13.4.6",
    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
