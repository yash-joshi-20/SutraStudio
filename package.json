{
  "name": "sutra-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prisma": "node scripts/prisma-cli.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:catalog": "npx tsx scripts/test-canonical-catalog.ts",
    "test:main-services": "npx tsx scripts/test-main-services-navigation.mjs",
    "test:pricing": "npx tsx scripts/test-display-pricing.mjs && node scripts/test-homepage-pricing-ui.mjs",
    "test:order-display": "npx tsx scripts/test-new-order-pricing.mjs",
    "test:services": "npx tsx scripts/test-service-detail-routes.mjs",
    "test:responsive": "node scripts/test-responsive-viewports.mjs",
    "test:client-ownership": "node scripts/test-client-ownership-isolation.mjs",
    "test:admin-catalog": "npx tsx scripts/test-admin-catalog-controls.mjs",
    "test:orders": "node scripts/test-order-pricing-canonical.mjs",
    "test:payments": "npx tsx scripts/test-payment-security-pipeline.mjs",
    "test": "npm run typecheck && npm run test:catalog && npm run lint && node scripts/verify-env-protection.mjs && node scripts/security-acceptance-tests.mjs",
    "test:automation": "npx tsx scripts/test-creative-automation-pipeline.mjs",
    "test:env": "node scripts/verify-env-protection.mjs",
    "test:security": "node scripts/security-acceptance-tests.mjs",
    "create-admin": "npx tsx scripts/create-admin.ts",
    "get-drive-token": "npx tsx scripts/get-drive-refresh-token.ts",
    "capture-assets": "npx tsx scripts/capture-live-assets.ts",
    "contract:emit": "prisma contract emit",
    "postinstall": "node scripts/prisma-cli.mjs contract emit || true"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/cli-engine": "^0.9.0",
    "@prisma/client": "^6.19.3",
    "@prisma/composer": "0.35.0",
    "@prisma/composer-prisma-cloud": "0.35.0",
    "@prisma/orm-postgres": "^8.0.0-rc.21",
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "framer-motion": "^13.4.6",
    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "prisma": "^8.0.0-rc.28",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "temporal-polyfill": "^1.0.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "tsx": "^4.19.2",
    "@types/pg": "^8.11.11"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@prisma/composer-prisma-cloud": {
      "@prisma/orm-postgres": "$@prisma/orm-postgres"
    }
  }
}
